/*
|--------------------------------------------------------------------------
| FUNÇÃO DE RISCO
|--------------------------------------------------------------------------
|
| Ainda é SOMENTE análise.
|
*/

function calculateEconomicRisk(
    int $transactions,
    int $added,
    int $removed,
    int $biggest
): array
{
    $volume = $added + $removed;

    $score = 0;
    $reasons = [];

    /*
     * Uma única movimentação extremamente alta.
     */

    if ($biggest >= 100000000000) {
        $score += 80;
        $reasons[] = 'Movimentação individual extremamente alta';
    } elseif ($biggest >= 10000000000) {
        $score += 60;
        $reasons[] = 'Movimentação individual muito alta';
    } elseif ($biggest >= 1000000000) {
        $score += 35;
        $reasons[] = 'Movimentação individual elevada';
    }


    /*
     * Volume total.
     */

    if ($volume >= 100000000000) {
        $score += 40;
        $reasons[] = 'Volume econômico extremamente alto';
    } elseif ($volume >= 20000000000) {
        $score += 30;
        $reasons[] = 'Volume econômico muito alto';
    } elseif ($volume >= 5000000000) {
        $score += 20;
        $reasons[] = 'Volume econômico elevado';
    } elseif ($volume >= 1000000000) {
        $score += 10;
        $reasons[] = 'Volume econômico acima do normal';
    }


    /*
     * Quantidade de operações.
     */

    if ($transactions >= 100) {
        $score += 20;
        $reasons[] = 'Grande quantidade de movimentações';
    } elseif ($transactions >= 50) {
        $score += 12;
        $reasons[] = 'Muitas movimentações';
    } elseif ($transactions >= 20) {
        $score += 5;
        $reasons[] = 'Quantidade elevada de movimentações';
    }


    /*
     * Limite.
     */

    if ($score >= 80) {
        $risk = 'CRITICAL';
    } elseif ($score >= 60) {
        $risk = 'HIGH';
    } elseif ($score >= 30) {
        $risk = 'MEDIUM';
    } else {
        $risk = 'NORMAL';
    }

    return [
        'score' => min(100, $score),
        'risk' => $risk,
        'reasons' => $reasons
    ];
}


/*
|--------------------------------------------------------------------------
| HISTÓRICO / FILTROS
|--------------------------------------------------------------------------
*/

$where = [];
$params = [];

if ($character !== '') {
    $where[] = "character_name LIKE ?";
    $params[] = '%' . $character . '%';
}

if ($account !== '') {
    $where[] = "account_name LIKE ?";
    $params[] = '%' . $account . '%';
}

if ($type !== '') {
    $where[] = "transaction_type = ?";
    $params[] = $type;
}

if ($severity !== '') {
    $where[] = "severity = ?";
    $params[] = $severity;
}

$whereSql = '';

if (!empty($where)) {
    $whereSql = 'WHERE ' . implode(' AND ', $where);
}


/*
|--------------------------------------------------------------------------
| CONTAGEM
|--------------------------------------------------------------------------
*/

$totalHistory = 0;

try {
    $stmt = $pdo->prepare("
        SELECT COUNT(*)
        FROM adena_transactions
        $whereSql
    ");

    $stmt->execute($params);

    $totalHistory = (int) $stmt->fetchColumn();
} catch (Throwable $e) {
}

$totalPages = max(1, (int) ceil($totalHistory / $perPage));

if ($page > $totalPages) {
    $page = $totalPages;
    $offset = ($page - 1) * $perPage;
}


/*
|--------------------------------------------------------------------------
| HISTÓRICO
|--------------------------------------------------------------------------
*/

$transactions = [];

try {
    $stmt = $pdo->prepare("
        SELECT
            id,
            character_name,
            account_name,
