            hwid,
            transaction_type,
            amount,
            balance_before,
            balance_after,
            severity,
            details,
            created_at
        FROM adena_transactions

        $whereSql

        ORDER BY id DESC

        LIMIT $perPage OFFSET $offset
    ");

    $stmt->execute($params);

    $transactions = $stmt->fetchAll();
} catch (Throwable $e) {
