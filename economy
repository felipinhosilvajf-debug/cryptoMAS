function h(?string $value): string
{
    return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
}

function formatAdena(int $value): string
{
    return number_format($value, 0, ',', '.');
}

function severityClass(string $severity): string
{
    switch (strtoupper($severity)) {
        case 'CRITICAL':
            return 'critical';

        case 'HIGH':
            return 'high';

        case 'MEDIUM':
            return 'medium';

        default:
            return 'low';
    }
}

function typeClass(string $type): string
{
    return strtoupper($type) === 'ADD'
        ? 'add'
        : 'remove';
}

function riskClass(string $risk): string
{
    switch (strtoupper($risk)) {
        case 'CRITICAL':
            return 'critical';

        case 'HIGH':
            return 'high';

        case 'MEDIUM':
            return 'medium';

        default:
            return 'normal';
    }
}

function buildPageUrl(int $page): string
{
    $query = $_GET;
    $query['page'] = $page;

    return '?' . http_build_query($query);
}


/*
|--------------------------------------------------------------------------
| ECONOMIA ATUAL
|--------------------------------------------------------------------------
|
| items:
| item_id = 57 = Adena
| owner_id = personagem
| count = saldo atual
|
*/

$totalAdena = 0;
$totalAdenaSemStaff = 0;
$totalPlayersWithAdena = 0;

try {
    $stmt = $pdo->query("
        SELECT
            COALESCE(SUM(i.count), 0) AS total_adena,
            COALESCE(SUM(
                CASE
                    WHEN c.accesslevel <> 100
                    THEN i.count
                    ELSE 0
                END
            ), 0) AS total_adena_sem_staff,
            COUNT(DISTINCT i.owner_id) AS total_players
        FROM items i
        INNER JOIN characters c
            ON c.obj_Id = i.owner_id
        WHERE i.item_id = 57
          AND i.owner_id > 0
          AND i.count > 0
    ");

    $row = $stmt->fetch();

    if ($row) {
        $totalAdena = (int) $row['total_adena'];
        $totalAdenaSemStaff = (int) $row['total_adena_sem_staff'];
        $totalPlayersWithAdena = (int) $row['total_players'];
    }
} catch (Throwable $e) {
}

try {
