}

.rune::after{

  content:"";

  position:absolute;

  inset:8px;

  border:
    1px solid rgba(213,180,106,.25);
}

.rune.r1{
  top:12%;
  left:10%;
}

.rune.r2{
  bottom:15%;
  left:18%;
  animation-delay:-1s;
}

.rune.r3{
  top:20%;
  right:10%;
  animation-delay:-2s;
}

.rune.r4{
  bottom:18%;
  right:15%;
  animation-delay:-3s;
}

@keyframes runeFloat{

  0%,100%{
    transform:
      rotate(45deg)
      translateY(0);

    opacity:.35;
