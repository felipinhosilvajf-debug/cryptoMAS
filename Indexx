
<!DOCTYPE html>
<html lang="pt-BR">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="icon" type="image/png" href="ico2.png" />

<title>L2 Virtual Boost — High Five</title>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

/* =========================================================
   L2 VIRTUAL BOOST
   DARK FANTASY — LINEAGE II H5
========================================================= */

:root{

  --black:#05070b;
  --black2:#080b12;
  --panel:#0b1019;
  --panel2:#0e1520;

  --blue:#4ca8ff;
  --blue2:#1769aa;
  --cyan:#75d7ff;

  --purple:#8c65ff;
  --purple2:#5634b8;

  --gold:#d5b46a;
  --gold2:#8e7134;
  --gold-light:#f0d99a;

  --text:#e7edf5;
  --muted:#8995a5;
  --muted2:#5f6b7b;

  --green:#63d39a;
  --red:#d96a6a;

  --line:rgba(130,170,220,.16);
  --glow:rgba(55,150,255,.25);
}

/* =========================================================
   RESET
========================================================= */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{

  background:
    radial-gradient(
      ellipse at 50% -10%,
      rgba(50,100,180,.18),
      transparent 55%
    ),
    linear-gradient(
      180deg,
      #05070b 0%,
      #080c13 45%,
      #05070b 100%
    );

  color:var(--text);

  font-family:'Rajdhani',sans-serif;

  overflow-x:hidden;
}

body::before{

  content:"";

  position:fixed;

  inset:0;

  pointer-events:none;

  z-index:999;

  background:
    linear-gradient(
      rgba(255,255,255,.015) 1px,
      transparent 1px
    );

  background-size:
    100% 4px;

  opacity:.12;
}

h1,
h2,
h3,
.logo{

  font-family:'Cinzel',serif;

  letter-spacing:1px;
}

/* =========================================================
   BACKGROUND
========================================================= */

.bg-fx{

  position:fixed;

  inset:0;

  z-index:-5;

  overflow:hidden;

  background:

    radial-gradient(
      circle at 50% 15%,
      rgba(75,140,255,.13),
      transparent 35%
    ),

    radial-gradient(
      circle at 15% 75%,
      rgba(95,55,180,.09),
      transparent 35%
    ),

    radial-gradient(
      circle at 85% 60%,
      rgba(35,100,170,.08),
      transparent 40%
    ),

    linear-gradient(
      180deg,
      #04060a,
      #090d14
    );
}

.bg-fx::after{

  content:"";

  position:absolute;

  inset:0;

  background:
    radial-gradient(
      ellipse at center,
      transparent 30%,
      rgba(0,0,0,.75) 100%
    );
}

/* =========================================================
   MAGIC PARTICLES
========================================================= */

.magic-particles{

  position:fixed;

  inset:0;

  z-index:-1;

  pointer-events:none;

  overflow:hidden;
}

.particle{

  position:absolute;

  bottom:-10px;

  width:2px;

  height:2px;

  border-radius:50%;

  background:#8ed8ff;

  box-shadow:
    0 0 8px #4ca8ff,
    0 0 16px rgba(76,168,255,.5);

  animation:
    rise linear infinite;
}

@keyframes rise{

  0%{

    transform:
      translateY(0)
      translateX(0);

    opacity:0;
  }

  15%{
    opacity:.8;
  }

  100%{

    transform:
      translateY(-100vh)
      translateX(50px);

    opacity:0;
  }
}

/* =========================================================
   ARCANE GRID
========================================================= */

.grid-fx{

  position:fixed;

  inset:0;

  z-index:-2;

  pointer-events:none;

  opacity:.35;

  background:

    linear-gradient(
      rgba(80,130,190,.025) 1px,
      transparent 1px
    ),

    linear-gradient(
      90deg,
      rgba(80,130,190,.025) 1px,
      transparent 1px
    );

  background-size:
    90px 90px;

  mask-image:
    radial-gradient(
      ellipse at center,
      black 0%,
      transparent 80%
    );
}

/* =========================================================
   NAVBAR
========================================================= */

nav{

  position:fixed;

  top:0;
  left:0;
  right:0;

  z-index:100;

  height:76px;

  display:flex;

  justify-content:space-between;

  align-items:center;

  padding:
    0 6vw;

  background:
    linear-gradient(
      180deg,
      rgba(3,5,9,.98),
      rgba(5,8,13,.88)
    );

  backdrop-filter:blur(15px);

  border-bottom:
    1px solid rgba(110,160,220,.22);

  box-shadow:
    0 8px 40px rgba(0,0,0,.6);
}

nav::after{

  content:"";

  position:absolute;

  bottom:-1px;
  left:10%;
  right:10%;

  height:1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--blue),
      var(--purple),
      var(--blue),
      transparent
    );

  box-shadow:
    0 0 12px rgba(76,168,255,.5);
}

/* =========================================================
   LOGO
========================================================= */

.logo{

  font-size:1.25rem;

  font-weight:900;

  cursor:pointer;

  color:#e9eef6;

  text-shadow:
    0 0 10px rgba(76,168,255,.35);

  white-space:nowrap;
}

.logo span{

  color:var(--blue);

  text-shadow:
    0 0 12px rgba(76,168,255,.8);
}

/* =========================================================
   NAV LINKS
========================================================= */

.navlinks{

  display:flex;

  align-items:center;

  gap:28px;
}

.navlinks a{

  position:relative;

  color:#aeb9c8;

  text-decoration:none;

  text-transform:uppercase;

  font-size:.78rem;

  font-weight:600;

  letter-spacing:1.5px;

  transition:.3s;
}

.navlinks a:hover{

  color:#fff;

  text-shadow:
    0 0 12px rgba(76,168,255,.8);
}

.navlinks a::before{

  content:"";

  position:absolute;

  bottom:-9px;

  left:50%;

  width:0;

  height:1px;

  transform:translateX(-50%);

  background:
    linear-gradient(
      90deg,
      var(--blue),
      var(--purple)
    );

  transition:.3s;

  box-shadow:
    0 0 8px var(--blue);
}

.navlinks a:hover::before{
  width:100%;
}

/* =========================================================
   BURGER
========================================================= */

.burger{

  display:none;

  flex-direction:column;

  gap:5px;

  cursor:pointer;
}

.burger span{

  width:27px;

  height:2px;

  background:
    linear-gradient(
      90deg,
      var(--blue),
      var(--purple)
    );

  box-shadow:
    0 0 8px rgba(76,168,255,.6);
}

/* =========================================================
   HERO
========================================================= */

header{

  min-height:100vh;

  position:relative;

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  text-align:center;

  padding:
    130px 6vw 90px;

  overflow:hidden;
}

/* Decorative circles */

header::before{

  content:"";

  position:absolute;

  width:700px;
  height:700px;

  border:
    1px solid rgba(76,168,255,.08);

  border-radius:50%;

  box-shadow:
    0 0 80px rgba(76,168,255,.04);

  animation:
    rotateRune 40s linear infinite;
}

header::after{

  content:"";

  position:absolute;

  width:500px;
  height:500px;

  border:
    1px solid rgba(140,101,255,.08);

  transform:
    rotate(45deg);

  box-shadow:
    inset 0 0 80px rgba(80,80,255,.03);

  animation:
    rotateRuneReverse 35s linear infinite;
}

@keyframes rotateRune{

  to{
    transform:rotate(360deg);
  }
}

@keyframes rotateRuneReverse{

  to{
    transform:rotate(-315deg);
  }
}

/* =========================================================
   HERO BADGE
========================================================= */

.badge{

  position:relative;

  z-index:2;

  display:inline-flex;

  align-items:center;

  gap:12px;

  padding:
    10px 25px;

  border:
    1px solid rgba(110,160,220,.35);

  background:
    rgba(8,13,21,.75);

  color:#9fc7ee;

  font-size:.7rem;

  letter-spacing:3px;

  text-transform:uppercase;

  box-shadow:
    0 0 25px rgba(40,110,180,.12);

  margin-bottom:30px;

  backdrop-filter:blur(8px);
}

.badge::before,
.badge::after{

  content:"◆";

  color:var(--gold);

  font-size:.55rem;
}

/* =========================================================
   HERO TITLE
========================================================= */

.hero-title{

  position:relative;

  z-index:2;

  font-size:
    clamp(3rem,8vw,7rem);

  line-height:.95;

  font-weight:900;

  text-transform:uppercase;

  margin-bottom:30px;
}

.hero-title .l2{

  display:block;

  color:#edf4fc;

  text-shadow:
    0 0 20px rgba(120,170,230,.3),
    0 5px 30px rgba(0,0,0,.8);
}

.hero-title .virtual{

  display:block;

  background:
    linear-gradient(
      180deg,
      #dfeeff 0%,
      #75c7ff 35%,
      #397fca 70%,
      #173b68 100%
    );

  -webkit-background-clip:text;

  background-clip:text;

  color:transparent;

  filter:
    drop-shadow(
      0 0 20px rgba(76,168,255,.4)
    );
}

.hero-title .boost{

  display:block;

  font-size:.48em;

  letter-spacing:9px;

  margin-top:15px;

  background:
    linear-gradient(
      90deg,
      var(--gold2),
      var(--gold-light),
      var(--gold),
      var(--gold2)
    );

  -webkit-background-clip:text;

  background-clip:text;

  color:transparent;

  text-shadow:none;
}

/* =========================================================
   HERO DESCRIPTION
========================================================= */

.hero-sub{

  position:relative;

  z-index:2;

  max-width:730px;

  color:#a9b5c5;

  font-size:
    clamp(1rem,2vw,1.2rem);

  line-height:1.8;

  margin-bottom:38px;
}

.hero-sub b{

  color:#e2e9f2;

  font-family:'Cinzel',serif;

  font-weight:600;
}

/* =========================================================
   BUTTONS
========================================================= */

.hero-cta{

  position:relative;

  z-index:5;

  display:flex;

  gap:16px;

  flex-wrap:wrap;

  justify-content:center;
}

.btn{

  position:relative;

  display:inline-flex;

  align-items:center;

  justify-content:center;

  min-height:56px;

  padding:
    0 34px;

  border:

    1px solid rgba(120,170,230,.45);

  color:#dceafa;

  background:
    linear-gradient(
      180deg,
      rgba(30,55,82,.55),
      rgba(8,15,24,.95)
    );

  text-decoration:none;

  text-transform:uppercase;

  font-family:'Cinzel',serif;

  font-size:.75rem;

  font-weight:700;

  letter-spacing:1.5px;

  transition:.35s;

  overflow:hidden;

  box-shadow:
    0 8px 30px rgba(0,0,0,.4);
}

.btn::before{

  content:"";

  position:absolute;

  inset:0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.08),
      transparent
    );

  transform:translateX(-100%);

  transition:.5s;
}

.btn:hover::before{
  transform:translateX(100%);
}

.btn:hover{

  color:#fff;

  border-color:var(--blue);

  transform:translateY(-3px);

  box-shadow:
    0 12px 35px rgba(30,110,190,.3),
    0 0 25px rgba(76,168,255,.15);
}

.btn-primary{

  border-color:
    rgba(76,168,255,.75);

  background:
    linear-gradient(
      135deg,
      rgba(25,87,145,.7),
      rgba(15,32,52,.95)
    );

  box-shadow:
    0 0 30px rgba(76,168,255,.12);
}

.btn-primary:hover{

  border-color:#8ed8ff;

  box-shadow:
    0 0 40px rgba(76,168,255,.35);
}

.btn-gold{

  border-color:
    rgba(213,180,106,.5);

  color:var(--gold-light);
}

.btn-gold:hover{

  border-color:var(--gold-light);

  box-shadow:
    0 0 35px rgba(213,180,106,.25);
}

/* =========================================================
   SCROLL
========================================================= */

.scroll-ind{

  position:absolute;

  bottom:28px;

  z-index:3;

  color:#63758b;

  font-size:.65rem;

  letter-spacing:4px;

  text-transform:uppercase;

  animation:
    scrollBob 2s infinite;
}

.scroll-ind::after{

  content:"";

  display:block;

  width:1px;

  height:45px;

  margin:
    10px auto 0;

  background:
    linear-gradient(
      var(--blue),
      transparent
    );
}

@keyframes scrollBob{

  0%,100%{
    transform:translateY(0);
    opacity:.5;
  }

  50%{
    transform:translateY(8px);
    opacity:1;
  }
}

/* =========================================================
   SECTIONS
========================================================= */

section{

  position:relative;

  padding:
    110px 6vw;
}

section::before{

  content:"";

  position:absolute;

  top:0;

  left:15%;

  right:15%;

  height:1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(90,140,200,.2),
      transparent
    );
}

.sec-title{

  text-align:center;

  font-size:
    clamp(1.7rem,4vw,2.8rem);

  font-weight:800;

  text-transform:uppercase;

  color:#dce8f5;

  margin-bottom:15px;

  text-shadow:
    0 5px 25px rgba(0,0,0,.8);
}

.sec-title .gold{

  color:var(--gold-light);

  text-shadow:
    0 0 20px rgba(213,180,106,.2);
}

.sec-lead{

  max-width:720px;

  margin:
    0 auto 55px;

  text-align:center;

  color:#7f8c9d;

  font-size:1.05rem;

  line-height:1.8;
}

.sec-lead b{
  color:#bfcbd9;
}

/* =========================================================
   CARDS
========================================================= */

.cards{

  max-width:1200px;

  margin:auto;

  display:grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(260px,1fr)
    );

  gap:20px;
}

.card{

  position:relative;

  padding:
    34px 28px;

  background:

    linear-gradient(
      145deg,
      rgba(17,26,38,.92),
      rgba(7,11,17,.96)
    );

  border:
    1px solid rgba(100,145,190,.14);

  transition:.4s;

  overflow:hidden;

  box-shadow:
    0 12px 40px rgba(0,0,0,.25);
}

.card::before{

  content:"";

  position:absolute;

  top:0;
  left:0;

  width:2px;

  height:0;

  background:
    linear-gradient(
      var(--blue),
      var(--purple)
    );

  transition:.4s;
}

.card::after{

  content:"";

  position:absolute;

  top:-100px;
  right:-100px;

  width:200px;
  height:200px;

  background:
    radial-gradient(
      circle,
      rgba(76,168,255,.1),
      transparent 70%
    );

  transition:.4s;
}

.card:hover{

  transform:
    translateY(-7px);

  border-color:
    rgba(76,168,255,.35);

  box-shadow:
    0 20px 60px rgba(0,0,0,.55),
    0 0 35px rgba(76,168,255,.08);
}

.card:hover::before{
  height:100%;
}

.card:hover::after{
  transform:scale(1.5);
}

.card .ic{

  display:block;

  font-size:2rem;

  margin-bottom:18px;

  filter:
    grayscale(.15)
    drop-shadow(
      0 0 10px rgba(76,168,255,.3)
    );
}

.card h3{

  color:#dbe8f5;

  font-size:1rem;

  margin-bottom:12px;

  text-transform:uppercase;
}

.card p{

  color:#788596;

  line-height:1.75;

  font-size:.95rem;
}

/* =========================================================
   PHILOSOPHY
========================================================= */

.philosophy{

  max-width:1050px;

  margin:auto;

  display:grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:20px;
}

.philosophy-card{

  position:relative;

  text-align:center;

  padding:
    42px 30px;

  background:
    linear-gradient(
      180deg,
      rgba(17,25,37,.9),
      rgba(7,11,17,.95)
    );

  border:
    1px solid rgba(100,145,190,.15);

  transition:.35s;
}

.philosophy-card:hover{

  transform:translateY(-6px);

  border-color:
    rgba(213,180,106,.4);

  box-shadow:
    0 20px 50px rgba(0,0,0,.5);
}

.philosophy-card .big{

  font-size:2.3rem;

  margin-bottom:18px;

  filter:
    grayscale(.25);
}

.philosophy-card h3{

  color:var(--gold-light);

  font-size:1rem;

  margin-bottom:12px;
}

.philosophy-card p{

  color:#788596;

  line-height:1.7;
}

/* =========================================================
   RATES
========================================================= */

.rates{

  max-width:1000px;

  margin:auto;

  display:grid;

  grid-template-columns:
    repeat(5,1fr);

  gap:15px;
}

.rate{

  position:relative;

  text-align:center;

  padding:
    30px 15px;

  background:
    linear-gradient(
      180deg,
      rgba(16,24,35,.9),
      rgba(7,11,17,.95)
    );

  border:
    1px solid rgba(100,145,190,.15);

  transition:.35s;
}

.rate:hover{

  transform:
    translateY(-5px);

  border-color:
    rgba(76,168,255,.4);

  box-shadow:
    0 15px 45px rgba(0,0,0,.5),
    0 0 25px rgba(76,168,255,.08);
}

.rate .num{

  font-family:'Cinzel',serif;

  font-size:2.2rem;

  font-weight:800;

  color:#8fcfff;

  text-shadow:
    0 0 18px rgba(76,168,255,.3);
}

.rate .lbl{

  margin-top:8px;

  color:#687587;

  font-size:.72rem;

  letter-spacing:2px;

  text-transform:uppercase;
}

/* =========================================================
   ECONOMY
========================================================= */

.economy-wrapper{

  max-width:1150px;

  margin:auto;
}

.economy-grid{

  display:grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(240px,1fr)
    );

  gap:20px;
}

.economy-card{

  padding:28px;

  background:
    linear-gradient(
      145deg,
      rgba(16,24,35,.9),
      rgba(7,11,17,.96)
    );

  border:
    1px solid rgba(100,145,190,.14);

  transition:.35s;
}

.economy-card:hover{

  border-color:
    rgba(213,180,106,.35);

  transform:translateY(-5px);
}

.economy-card .icon{

  font-size:1.8rem;

  margin-bottom:14px;
}

.economy-card h3{

  color:#d9e5f1;

  font-size:.95rem;

  text-transform:uppercase;

  margin-bottom:10px;
}

.economy-card p{

  color:#748193;

  line-height:1.7;
}

/* =========================================================
   ECONOMIC INDEX
========================================================= */

.economy-index{

  margin-top:25px;

  display:grid;

  grid-template-columns:
    180px 1fr;

  gap:30px;

  align-items:center;

  padding:30px;

  background:
    linear-gradient(
      135deg,
      rgba(20,31,42,.95),
      rgba(7,11,17,.98)
    );

  border:
    1px solid rgba(100,145,190,.2);
}

.index-number{

  font-family:'Cinzel',serif;

  font-size:3.5rem;

  font-weight:900;

  color:var(--green);

  text-align:center;

  text-shadow:
    0 0 20px rgba(99,211,154,.25);
}

.index-info h3{

  color:var(--gold-light);

  margin-bottom:8px;
}

.index-info p{

  color:#788596;

  line-height:1.6;
}

.status{

  display:inline-block;

  margin-top:12px;

  padding:
    5px 12px;

  border:
    1px solid rgba(99,211,154,.3);

  color:var(--green);

  font-size:.7rem;

  letter-spacing:1.5px;

  text-transform:uppercase;
}

/* =========================================================
   MARKET
========================================================= */

.market{

  margin-top:25px;

  display:grid;

  grid-template-columns:
    repeat(4,1fr);

  gap:15px;
}

.market-item{

  padding:18px;

  display:flex;

  justify-content:space-between;

  align-items:center;

  background:
    rgba(255,255,255,.018);

  border:
    1px solid rgba(100,145,190,.1);
}

.market-item strong{

  color:#bdc9d8;

  font-size:.9rem;
}

.market-price{

  color:var(--gold-light);

  font-family:'Cinzel',serif;

  font-size:.75rem;
}

.up{
  color:var(--green);
}

.down{
  color:var(--red);
}

/* =========================================================
   FORGE / DOWNLOAD
========================================================= */

.fusion-box{

  max-width:1050px;

  margin:auto;

  display:grid;

  grid-template-columns:
    1fr 1fr;

  gap:70px;

  align-items:center;
}

/* =========================================================
   ARCANE SWORD
========================================================= */

.fusion-visual{

  height:360px;

  position:relative;

  display:flex;

  justify-content:center;

  align-items:center;
}

.fusion-visual::before{

  content:"";

  position:absolute;

  width:280px;
  height:280px;

  border:
    1px solid rgba(76,168,255,.15);

  border-radius:50%;

  box-shadow:
    0 0 80px rgba(76,168,255,.08);

  animation:
    rotateRune 20s linear infinite;
}

.sword-container{

  position:relative;

  z-index:3;

  transform:
    rotate(8deg);

  filter:
    drop-shadow(
